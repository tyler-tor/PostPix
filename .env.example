# Copy this file to .env and fill in real values. NEVER commit .env.
# All values below are placeholders.

# Flask
FLASK_APP=app
# Picks the config class in app/config.py: development (default), testing or production.
# "production" turns on secure cookies and requires SECRET_KEY and DATABASE_URL.
FLASK_ENV=development
# Flask 3 no longer turns on the debugger/auto-reload from FLASK_ENV; use this locally.
FLASK_DEBUG=1
# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Database. Local dev can use SQLite (a relative path lives in the instance/ folder):
DATABASE_URL=sqlite:///dev.db
# Production example (Postgres; postgres:// and postgresql:// are turned into
# postgresql+psycopg:// automatically):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Set to true only when debugging SQL locally (prints every query)
SQLALCHEMY_ECHO=false

# S3 image uploads (leave blank locally if you are not testing uploads)
S3_BUCKET=your-bucket-name
S3_KEY=your-access-key-id
S3_SECRET=your-secret-access-key

# Frontend (Vite): the React app needs no environment variables today.
# If you add one, it must start with VITE_ (e.g. VITE_SENTRY_DSN) and is read in
# code as import.meta.env.VITE_SENTRY_DSN. Put it in react-app/.env.local.
# Never put secrets in VITE_ variables: they are baked into the public JS bundle.
