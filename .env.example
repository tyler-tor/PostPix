# PostPix environment variables.
#
# Copy this file to .env for local development and fill in real values:
#   cp .env.example .env
# NEVER commit .env. Every value in this file is a placeholder.
#
# Uncommented lines are sensible LOCAL DEVELOPMENT values. Commented lines are
# optional or production-only; the "Production" block at the end lists what the
# server needs (set there by the infra repo, not from this file).
# Non-secret Flask CLI settings (FLASK_APP, FLASK_RUN_PORT=8000) live in the
# committed .flaskenv; anything set here wins over it.

# ==== Flask =====================================================================
# Config class in app/config.py: development (default), testing or production.
# "production" turns on Secure cookies, HSTS and the proxy settings below, and
# refuses to start without SECRET_KEY and DATABASE_URL.
FLASK_ENV=development
# Flask 3 no longer turns on the debugger/auto-reload from FLASK_ENV; use this locally.
FLASK_DEBUG=1
# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# (Empty in development = a new random key on every restart, which logs you out.)
SECRET_KEY=replace-with-a-long-random-string

# ==== Database ==================================================================
# Local: SQLite (a relative path lives in the instance/ folder -> instance/dev.db).
DATABASE_URL=sqlite:///dev.db
# Postgres: postgres:// and postgresql:// are turned into postgresql+psycopg:// for you.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Optional: password kept out of the URL (escaped for you; RDS passwords contain @ / : #).
# DATABASE_PASSWORD=
# SSL to Postgres. RDS: require. (verify-full also needs DATABASE_SSLROOTCERT=/path/to/rds-ca.pem)
# DATABASE_SSLMODE=require
# DATABASE_SSLROOTCERT=
# Connection pool per gunicorn worker process (Postgres only). Defaults shown.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=2
# DB_POOL_RECYCLE=300
# DB_CONNECT_TIMEOUT=10
# DB_APPLICATION_NAME=postpix
# Set to true only when debugging SQL locally (prints every query).
SQLALCHEMY_ECHO=false

# ==== Images (S3) ===============================================================
# No access keys: boto3 uses the EC2 instance role in production and your AWS CLI
# profile locally (`aws sso login --profile <name>`). Leave S3_BUCKET empty if you
# are not testing uploads (uploads then fail cleanly with "S3 is not configured").
S3_BUCKET=
AWS_REGION=us-east-2
# AWS_PROFILE=your-local-profile
# Public base URL of the bucket's files (CloudFront). Empty locally: seed images then
# use their original URLs, and uploads use the bucket's S3 URL.
MEDIA_BASE_URL=

# ==== Proxy and security ========================================================
# How many reverse proxies to trust for X-Forwarded-Proto/Host (and -For).
# Default: 1 in production (Caddy), 0 otherwise. Keep 0 locally.
# TRUSTED_PROXY_HOPS=0
# TRUSTED_PROXY_HOPS_FOR=0
# Strict-Transport-Security max-age in production (0 = do not send).
# HSTS_SECONDS=31536000
# Serve react-app/build from Flask. Default: on in development, off in production.
# SERVE_FRONTEND=true

# ==== Server (gunicorn / Docker) ================================================
# PORT=8000              listen on 0.0.0.0:PORT (the Docker image sets 8000)
# BIND=127.0.0.1:8000    full address, wins over PORT
# WEB_CONCURRENCY=2      worker processes
# GUNICORN_THREADS=4     threads per worker
# GUNICORN_TIMEOUT=30
# LOG_LEVEL=info
# Container start-up (docker/entrypoint.sh), both off by default:
# RUN_MIGRATIONS=1       run `flask db upgrade` first
# SEED_ON_START=1        run `flask seed all` first (only seeds an empty database)

# ==== Local development ports ===================================================
# Flask: `flask run` uses port 8000 (FLASK_RUN_PORT in .flaskenv).
# Frontend: Vite (port 3000) proxies /api to http://localhost:8000. To point it
# elsewhere, put VITE_BACKEND_URL=http://localhost:9000 in react-app/.env.local.
# Never put secrets in VITE_ variables: anything the browser code imports is public.

# ==== Tests =====================================================================
# python -m pytest uses in-memory SQLite; set this to run the tests on Postgres.
# TEST_DATABASE_URL=postgresql://postpix:postpix@localhost:5433/postpix_test

# ==== Production (reference only: set on the server, never in a committed file) ==
# FLASK_ENV=production
# SECRET_KEY=<new value from secrets.token_hex(32)>
# DATABASE_URL=postgresql://postpix@<rds-endpoint>:5432/postpix
# DATABASE_PASSWORD=<from SSM Parameter Store / Secrets Manager>
# DATABASE_SSLMODE=require
# S3_BUCKET=<uploads bucket name>
# AWS_REGION=us-east-2
# MEDIA_BASE_URL=https://postpix.tylertorrero.dev/media
# TRUSTED_PROXY_HOPS=1
# PORT=8000
