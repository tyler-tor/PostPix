# Copy this file to .env and fill in real values. NEVER commit .env.
# All values below are placeholders.

# Flask
FLASK_APP=app
# "production" turns on secure cookies and requires SECRET_KEY. Use "development" locally.
FLASK_ENV=development
# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Database. Local dev can use SQLite:
DATABASE_URL=sqlite:///dev.db
# Production example (Postgres):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Postgres schema name used in production only
SCHEMA=postpix_schema

# Set to true only when debugging SQL locally (prints every query)
SQLALCHEMY_ECHO=false

# S3 image uploads (leave blank locally if you are not testing uploads)
S3_BUCKET=your-bucket-name
S3_KEY=your-access-key-id
S3_SECRET=your-secret-access-key

# Frontend
REACT_APP_BASE_URL=http://localhost:5000
