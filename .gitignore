# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---- Secrets / environment ----------------------------------------------
# Never commit real environment files. Only .env.example (placeholders) is tracked.
.env
.env.*
!.env.example
.envexample
.flaskenv
*.pem
*.key

# ---- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
instance/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# ---- Databases ----------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# ---- Node / React -------------------------------------------------------
node_modules/
/.pnp
.pnp.js
react-app/build/
/coverage
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Infrastructure (later batches) -------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# ---- OS / editors -------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
